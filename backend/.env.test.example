NODE_ENV=test
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
CLIENT_ORIGIN=http://localhost:5173

# Use a dedicated database for tests only.
# Example:
# MONGODB_URI_TEST=mongodb+srv://<user>:<pass>@<cluster>/gympro_test?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>/gympro_test?retryWrites=true&w=majority
MONGODB_URI_TEST_CMD=cmd /c npx vitest run --config .\vitest.config.js tests/integration/auth.test.js --reporter=verbose

